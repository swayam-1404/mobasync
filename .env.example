# Discord Bot Token (obtained from Discord Developer Portal)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Comma-separated list of authorized Discord User IDs (e.g., 123456789012345678,987654321098765432)
AUTHORIZED_USERS=

# Base directory for allowed file transfers (resolved relative to home if starting with ~)
SEND_FILES_PATH=~/SEND_FILES

# Application and audit logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security and Rate Limiting Settings
RATE_LIMIT_COMMANDS_PER_MIN=20
RATE_LIMIT_TRANSFERS_PER_MIN=10

# Large File Handling Strategy (options: compress, split, link, notify)
LARGE_FILE_STRATEGY=split

# Optional Discord Guild ID for faster Slash Command registration during development
DISCORD_GUILD_ID=
